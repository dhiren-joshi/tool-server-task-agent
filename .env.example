# Bodhan issues separate keys for each model.
BODHAN_TRANSCRIBE_KEY=replace_me
BODHAN_TRANSLATE_KEY=replace_me
BODHAN_SPEAK_KEY=replace_me
BODHAN_OCR_KEY=replace_me

# General-purpose OpenAI-compatible LLM used only for planning/reasoning/English summaries.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=replace_with_a_tool_calling_model
LLM_API_KEY=replace_me

# Runtime safeguards
BODHAN_API_BASE_URL=https://api.bodhan.ai
BODHAN_REQUEST_TIMEOUT_SECONDS=60
BODHAN_MAX_RETRIES=2
BODHAN_MAX_CONCURRENT_REQUESTS=3
TRANSLATION_CHUNK_CHARS=8000
TTS_CHUNK_CHARS=240
AUDIO_CHUNK_SECONDS=29

BODHAN_MCP_ALLOWED_ROOT=.
